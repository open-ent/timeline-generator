<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.openent</groupId>
        <artifactId>app-parent</artifactId>
        <version>1.2.0</version>
    </parent>

    <groupId>net.atos</groupId>
    <artifactId>timelinegenerator</artifactId>
    <version>3.3.7-patched</version>

    <scm>
        <connection>scm:git:https://github.com/OPEN-ENT-NG/timeline-generator.git</connection>
        <developerConnection>scm:git:https://github.com/OPEN-ENT-NG/timeline-generator.git</developerConnection>
        <url>https://github.com/OPEN-ENT-NG/timeline-generator</url>
    </scm>

    <repositories>
        <repository>
            <id>ode</id>
            <name>ODE Repository</name>
            <url>https://maven.opendigitaleducation.com/nexus/content/groups/public</url>
        </repository>
    </repositories>

    <properties>
        <entCoreVersion>6.14.9-patched</entCoreVersion>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
            <version>${vertxVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.entcore</groupId>
            <artifactId>common</artifactId>
            <version>${entCoreVersion}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            org.entcore:tests ne fournit QUE les scénarios Gatling/Scala (src/test/scala/**),
            jamais joués en CI. Depuis le 08/09/2026, le module `tests` d'entcore est exclu de la
            publication du fork (open-ent/entcore-v2, commit 275a060 : maven-scala-plugin 2.15.2 ne
            compile plus Scala 2.12 sous JDK 21), donc org.entcore:tests:*-patched n'existe plus.
            Maven résout les dépendances de portée `test` même avec -Dmaven.test.skip=true : laissée
            dans <dependencies>, elle faisait échouer `mvn package` (donc toute la CI).
            `mvn -Pgatling-it ...` pour la réactiver le jour où l'artefact sera republié.
        -->
        <profile>
            <id>gatling-it</id>
            <dependencies>
                <dependency>
                    <groupId>org.entcore</groupId>
                    <artifactId>tests</artifactId>
                    <version>${entCoreVersion}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
