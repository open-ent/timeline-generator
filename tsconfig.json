{
    "compilerOptions": {
      "target": "es5",
      "module": "commonjs",
      "declaration": false,
      "moduleResolution": "node",
      "sourceMap": true,
      "noImplicitAny": false,
      "lib": ["es2015", "dom"],
      "skipLibCheck": true
    },
    "exclude": [
      "build", "node_modules", "frontend"
    ]
  }